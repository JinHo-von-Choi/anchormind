{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude-code-marketplace.schema.json",
  "title": "Claude Code .claude-plugin/marketplace.json",
  "description": "Written from https://code.claude.com/docs/en/plugins/marketplace-reference (top-level fields, plugin entries, relative path plugin source, reserved names checked separately in the test).",
  "type": "object",
  "required": ["name", "owner", "plugins"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "not": { "pattern": "\\.\\." } },
    "owner": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "source": { "type": "string", "pattern": "^\\./", "not": { "pattern": "\\.\\.|\\\\" } },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
