{
  "name": "anchormind-mcp",
  "version": "6.3.0",
  "license": "Apache-2.0",
  "description": "Fragment-Based Memory MCP Server",
  "main": "server.js",
  "files": [
    "bin/",
    "lib/",
    "config/",
    "scripts/",
    "assets/admin/",
    "assets/images/",
    "integrations/",
    "server.js",
    "setup.sh",
    "SKILL.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    ".env.example",
    ".env.example.minimal"
  ],
  "type": "module",
  "bin": {
    "anchormind": "bin/memento.js",
    "memento-mcp": "bin/memento.js"
  },
  "scripts": {
    "start": "node server.js",
    "test": "DOTENV_CONFIG_PATH=.env.test MEMENTO_METRICS_DEFAULT=off REDIS_ENABLED=false CACHE_ENABLED=false node --experimental-test-module-mocks --test tests/unit/*.test.js tests/unit/*/*.test.js tests/structure/*.test.js",
    "test:coverage": "mkdir -p coverage && DOTENV_CONFIG_PATH=.env.test MEMENTO_METRICS_DEFAULT=off REDIS_ENABLED=false CACHE_ENABLED=false node --experimental-test-module-mocks --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-reporter=dot --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/unit/*.test.js tests/unit/*/*.test.js tests/structure/*.test.js && node scripts/check-coverage.js coverage/lcov.info",
    "test:integration": "DOTENV_CONFIG_PATH=.env.test MEMENTO_METRICS_DEFAULT=off node --experimental-test-module-mocks --test tests/integration/*.test.js tests/e2e/*.test.js",
    "test:integration:llm": "MEMENTO_METRICS_DEFAULT=off node --test --test-concurrency=1 tests/integration/llm-cli-smoke.test.js tests/integration/llm-timeout.test.js tests/integration/morpheme-llm-real.test.js tests/integration/llm-chain-real.test.js",
    "test:e2e": "DOTENV_CONFIG_PATH=.env.test MEMENTO_METRICS_DEFAULT=off node --experimental-test-module-mocks --test --test-concurrency=1 tests/e2e/*.test.js",
    "test:e2e:local": "bash scripts/run-e2e-tests.sh",
    "test:db": "DOTENV_CONFIG_PATH=.env.test MEMENTO_METRICS_DEFAULT=off REDIS_ENABLED=false CACHE_ENABLED=false node --experimental-test-module-mocks --test --test-concurrency=1 tests/db-concurrency/*.test.js",
    "test:ci": "npm test && npm run test:integration",
    "lint": "eslint .",
    "lint:ratchet": "node scripts/lint-ratchet.js",
    "backfill:embeddings": "node scripts/backfill-embeddings.js",
    "backfill:synthetic-query-versions": "node scripts/backfill-synthetic-query-versions.js",
    "lint:migrations": "node scripts/lint-migrations.js",
    "switches": "node scripts/switch-report.mjs",
    "env-access": "node scripts/env-access-report.mjs",
    "audit:ci": "audit-ci --config audit-ci.jsonc",
    "migrate": "node scripts/migrate.js",
    "release": "node scripts/release.js",
    "cli": "node bin/memento.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@node-rs/jieba": "^2.0.3",
    "dotenv": "^18.0.4",
    "garu-ko": "^0.9.18",
    "ioredis": "^6.0.0",
    "js-tiktoken": "^1.0.21",
    "kuromoji": "^0.1.2",
    "natural": "^8.1.1",
    "node-fetch": "^3.3.2",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "acorn": "^8.18.0",
    "audit-ci": "^7.1.0",
    "eslint": "^10.11.0"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "@hono/node-server": "^2.0.5",
    "mongoose": "^9.9.1",
    "tar": "^7.5.22",
    "body-parser": "^2.3.0",
    "sharp": "^0.35.5",
    "ip-address": "^10.3.1",
    "adm-zip": "^0.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JinHo-von-Choi/anchormind.git"
  },
  "bugs": {
    "url": "https://github.com/JinHo-von-Choi/anchormind/issues"
  },
  "homepage": "https://github.com/JinHo-von-Choi/anchormind#readme"
}
