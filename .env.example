# Memento MCP 환경변수 샘플
# 최소 시작 경로: cp .env.example.minimal .env
# 운영형 샘플: cp .env.example .env
# 작성일: 2026-03-03
# 수정일: 2026-10-03

# ─────────────────────────────────────────
# 숫자, 열거, 불리언 변수의 허용 범위 (docs/configuration.md의 「허용 범위」와 같다)
# ─────────────────────────────────────────
# 숫자가 아니거나 범위 밖인 값의 처리는 MEMENTO_CONFIG_STRICT 설명을 따른다.
# 0 이상의 정수: CACHE_DB_TTL, CACHE_SESSION_TTL, DB_CONN_TIMEOUT_MS, DB_IDLE_TIMEOUT_MS, DB_QUERY_TIMEOUT,
#   DB_STATEMENT_TIMEOUT_MS, EMBEDDING_MAX_RETRIES, EMBEDDING_SEM_WAIT_MS, HEADERS_TIMEOUT_MS, KEEP_ALIVE_TIMEOUT_MS,
#   LLM_CB_OPEN_DURATION_MS, LLM_CHAIN_TIMEOUT_MS, LLM_CONCURRENCY_WAIT_MS, LLM_PROVIDER_TIMEOUT_MS,
#   LLM_TOKEN_BUDGET_INPUT, LLM_TOKEN_BUDGET_OUTPUT, QUOTA_NEAR_LIMIT_MARGIN, REDIS_DB, REQUEST_TIMEOUT_MS,
#   RERANKER_EXTERNAL_COOLDOWN_MS, SSE_RETRY_MS, TRUST_PROXY_HOPS
# 0 이상의 숫자: MCP_IDLE_REFLECT_HOURS, UPDATE_CHECK_INTERVAL_HOURS
# 1 이상의 정수: DEFAULT_DAILY_LIMIT, DEFAULT_FRAGMENT_LIMIT, FRAGMENT_DEFAULT_LIMIT, EMBEDDING_CONCURRENCY,
#   EMBEDDING_DIMENSIONS, EMBEDDING_TIMEOUT_MS, LLM_CB_FAILURE_THRESHOLD, LLM_CB_FAILURE_WINDOW_MS,
#   LLM_TOKEN_BUDGET_WINDOW_SEC, NLI_TIMEOUT_MS, RATE_LIMIT_MAX_REQUESTS, RATE_LIMIT_PER_IP, RATE_LIMIT_PER_KEY,
#   RATE_LIMIT_WINDOW_MS, RERANKER_TIMEOUT_MS, SESSION_TTL_MINUTES, SSE_MAX_HEARTBEAT_FAILURES
# 2 이상의 정수: DB_MAX_CONNECTIONS
# 1000 이상의 정수: SSE_HEARTBEAT_INTERVAL_MS
# 1 이상 65535 이하의 정수: POSTGRES_PORT, DB_PORT, REDIS_PORT
# 0 이상 65535 이하의 정수: PORT
# 0 이상의 정수, 그 밖은 기본값: MEMENTO_SHUTDOWN_DEADLINE_MS(60000), MEMENTO_SESSION_KEY_RECHECK_MS(30000),
#   MEMENTO_DCR_MAX_PER_HOUR(100), MEMENTO_SCORE_UPDATE_BATCH(200, 10000을 넘으면 10000)
# 100 이상 4500 이하의 정수, 그 밖은 2000: MEMENTO_HEALTH_READY_DB_TIMEOUT_MS
# 1 이상 100 이하의 정수, 그 밖은 12: MEMENTO_OUTBOX_MAX_ATTEMPTS
# 1 이상 3650 이하의 정수, 그 밖은 7: MEMENTO_OUTBOX_RETENTION_DAYS, MEMENTO_OUTBOX_UNHANDLED_DAYS
# 1 이상의 숫자, 그 밖은 SESSION_TTL_MINUTES * 60: OAUTH_ACCESS_TOKEN_TTL_SECONDS
# 0 이상 1 이하의 숫자(1을 넘으면 1, 음수와 숫자가 아닌 값은 0): MEMENTO_DECAY_MIN_DELTA, MEMENTO_UTILITY_MIN_DELTA
# off, warn, enforce(공백만 있는 값을 포함한 그 밖의 값은 enforce로 동작): MEMENTO_TOOL_ARGS_VALIDATION
# warn, enforce(그 밖의 값은 warn): MEMENTO_SESSION_ID_POLICY, MEMENTO_RESERVED_AGENT_IDS, MEMENTO_OAUTH_REDIRECT_CHECK
# reflect, observe, allowlist(그 밖의 값은 observe): MEMENTO_CORS_MODE
# allow, deny(그 밖의 값은 allow): MEMENTO_SSE_QUERY_KEY
# deny(그 밖의 값은 헤더를 붙이지 않음): MEMENTO_FRAME_OPTIONS
# 401, 503(그 밖의 값은 401): MEMENTO_AUTH_STORE_UNAVAILABLE_STATUS
# inner, outer(그 밖의 값은 inner): MEMENTO_SEMANTIC_THRESHOLD_MODE
# none, all(그 밖의 값은 none): MEMENTO_LLM_CLI_TOOL_APPROVAL
# true, false(그 밖의 값은 false): MEMENTO_CONFIG_STRICT
# true, false(그 밖의 값은 MEMORY_CONFIG 검증에서 기동 실패, 기본 true): MEMENTO_AUTO_PROMOTE_ANCHORS
# on, off(그 밖의 값은 off): MEMENTO_ADMIN_AUTH_BACKOFF
# on, off(그 밖의 값은 on): MEMENTO_WRITE_GATE, MEMENTO_OUTBOX, MEMENTO_OUTBOX_WORKER
# mask, reject, off(그 밖의 값은 mask): MEMENTO_SENSITIVE_SCAN
# true, false(false가 아닌 값은 true): MEMENTO_API_KEY_DELETE_GUARD, MEMENTO_ALLOW_LEGACY_UNBOUND_AGENT_SCOPE,
#   LLM_CONCURRENCY_ENABLED, MCP_REJECT_NONAPIKEY_OAUTH
# true, false(true가 아닌 값은 false): MEMENTO_LOG_STDERR, MEMENTO_REMEMBER_DUPLICATE_GUARD, MEMENTO_REMEMBER_ATOMIC, MEMENTO_WORKSPACE_GATE,
#   MEMENTO_TOOL_ARGS_ALLOW_UNKNOWN, ENABLE_RECONSOLIDATION, ENABLE_SPREADING_ACTIVATION, UPDATE_REQUIRE_SIGNED_TAG,
#   MEMENTO_AUTH_DISABLED, REDIS_ENABLED, REDIS_SENTINEL_ENABLED, MEMENTO_REDIS_SESSION_FAIL_CLOSED,
#   EMBEDDING_SUPPORTS_DIMS_PARAM, MEMENTO_RERANKER_ENABLED, MEMENTO_CASE_BACKPROP_ENABLED, UPDATE_CHECK_DISABLED,
#   ENABLE_OPENAPI, MCP_ALLOW_AUTO_DCR_REGISTER, MCP_STRICT_ORIGIN
# true, false(true가 아닌 값은 REDIS_ENABLED 값): CACHE_ENABLED

# ─────────────────────────────────────────
# 서버
# ─────────────────────────────────────────
PORT=57332
SESSION_TTL_MINUTES=43200       # 기본값 43200 (30일 슬라이딩, claude.ai 커넥터 호환)
LOG_DIR=./logs
# LOG_LEVEL=info                   # winston 로그 레벨 (error/warn/info/debug)

# HTTP 타임아웃 (server.js)
# KEEP_ALIVE_TIMEOUT_MS=75000      # Keep-Alive 연결 유지 시간 ms (기본 75000); proxy 뒤에서는 proxy 설정과 일치시킬 것
# HEADERS_TIMEOUT_MS=76000         # 요청 헤더 수신 완료까지 허용 시간 ms (기본 76000); KEEP_ALIVE_TIMEOUT_MS보다 크게 유지
# REQUEST_TIMEOUT_MS=60000         # 요청 수신 상한 ms (기본 60000, 0이면 무제한). 본문을 다 받는 데 걸리는 시간만 제한한다

# ─────────────────────────────────────────
# 인증
# 설정 시 모든 요청에 Bearer 토큰 필수
# ─────────────────────────────────────────
# MEMENTO_ACCESS_KEY=your-master-key-here

# 브라우저 기반 MCP 클라이언트가 호출할 도메인 화이트리스트.
# 미설정 시 모든 Origin에 응답한다(응답 방식은 MEMENTO_CORS_MODE로 정한다). 설정하면 목록 밖 Origin은 403.
#
# 데스크탑/CLI/IDE 확장은 Origin 헤더를 보내지 않으므로 화이트리스트 불필요.
# (Claude Code/Cursor/Windsurf/Continue/Cline/Zed/Jan/CLI 도구 등)
#
# 브라우저 MCP 클라이언트 후보 (실제 호출하는 것만 선별해 활성화):
# - Anthropic Claude        : https://claude.ai,https://claude.com
# - OpenAI ChatGPT          : https://chatgpt.com,https://chat.openai.com
# - Microsoft Copilot       : https://copilot.microsoft.com
# - Google Gemini/AIStudio  : https://gemini.google.com,https://aistudio.google.com
# - Perplexity              : https://www.perplexity.ai,https://labs.perplexity.ai
# - Cursor 웹               : https://cursor.com,https://www.cursor.com
# - Codeium/Windsurf 웹     : https://codeium.com,https://windsurf.com
# - Sourcegraph Cody        : https://sourcegraph.com
# - TypingMind              : https://typingmind.com
# - Open WebUI/LibreChat    : 셀프호스팅 인스턴스 도메인
#
# 예:
# ALLOWED_ORIGINS=https://claude.ai,https://claude.com,https://chatgpt.com,https://chat.openai.com,https://copilot.microsoft.com,https://gemini.google.com,https://aistudio.google.com

# Admin UI 호출 origin 화이트리스트. 미설정 시 Origin 검사를 하지 않는다. 설정하면 목록 밖 Origin은 403.
# ADMIN_ALLOWED_ORIGINS=https://admin.example.com

# 신뢰 가능한 리버스 프록시 hop 수. 미설정 시 기존 동작(XFF 첫 항목) 유지하며,
# X-Forwarded-For를 받으면 경고 1회와 /stats healthFlags의 trust_proxy_hops_unset으로 알린다.
# 직접 인터넷 노출 시 0 권장(헤더 무시). 단일 nginx 뒤에서는 1(체인의 오른쪽에서 1번째 항목 채택).
# 실제 프록시 단수와 정확히 일치시킨다. 실제보다 크게 잡으면 클라이언트가 보낸 값이 채택된다.
# TRUST_PROXY_HOPS=1

# OAuth redirect_uri 정확 일치 허용 목록(쉼표 구분). 기본 신뢰 도메인, OAUTH_TRUSTED_ORIGINS, localhost는 별도로 허용된다.
# OAUTH_ALLOWED_REDIRECT_URIS=https://app.example.com/callback

# 인증 비활성화 (개발 전용).
# MEMENTO_ACCESS_KEY가 비어 있으면 서버는 기동하지 않는다. 인증 없이 띄우려면
# 그 의사를 여기서 명시해야 한다.
# MEMENTO_AUTH_DISABLED=false

# workspace 격리 집행. true면 허가 집합 밖 workspace 주장이 저장 거부된다.
# 기본값에서는 경고만 남긴다. 다만 허가 여부를 판정하지 못한 경우(DB 조회 실패)는
# 이 스위치와 무관하게 항상 거부한다.
# MEMENTO_WORKSPACE_GATE=false

# 의미 쓰기 관문(on|off, 기본 on). on이면 remember, amend, batch_remember, reflect 파생 쓰기,
# AutoReflect, 가져오기(admin, CLI), CLI remember 로컬 모드, 통합 분할 자식이 같은 관문(정규화, 민감 정보 마스킹,
# 길이 상한, PolicyRules, workspace 허가, 앵커 권한)을 거친다. 위반은 validation_warnings 경고로
# 남고 hard gate 키에서만 거부한다. off는 진입점별 기본 단계만 적용한다.
# off여도 가져오기와 CLI remember 로컬 모드는 FragmentWriter로 기록하므로 중복 판정, 유형별
# importance 상한, 본문 전체 sha256 content_hash는 그대로 적용된다.
# 호출 시점에 읽으므로 재시작 없이 바뀐다.
# MEMENTO_WRITE_GATE=on

# 쓰기 값의 비밀과 개인정보 탐지(mask|reject|off, 기본 mask). 대상은 content, topic, contextSummary,
# goal, outcome, keywords다. mask는 일치한 값을 표식으로 바꿔 저장한다. 이메일과 휴대전화 번호는
# 가리기만 하고 그 밖의 탐지는 규칙 이름만 validation_warnings(sensitive.<규칙>, 알림이며 재시도 불필요)에
# 남긴다. symbolic_hard_gate 키는 고신뢰 규칙(비밀번호 필드, API 키 패턴, 토큰, 개인 키, 주민등록번호,
# 카드 번호)의 탐지에서 -32003으로 거부하므로, hard gate 키를 쓰는 배포는 클라이언트의 처리를 확인한다.
# reject는 모든 키가 같은 탐지에서 거부한다. off는 레거시 규칙(API 키, 이메일, 비밀번호 필드,
# 휴대전화 번호)만 content에 적용한다. MEMENTO_WRITE_GATE=off이면 off로 동작한다.
# 호출 시점에 읽으므로 재시작 없이 바뀐다.
# MEMENTO_SENSITIVE_SCAN=mask

# 콘솔 로그를 표준 오류로 보낸다(true|false, 기본 false). CLI는 serve를 뺀 명령에서 값이 없으면
# true로 정해 표준 출력을 명령 결과에만 쓴다. 로거가 처음 적재될 때 읽는다.
# MEMENTO_LOG_STDERR=false

# MCP tools/call 인자 점검 모드(off|warn|enforce, 기본 warn).
# warn은 스키마와 맞지 않는 호출을 [ToolArgs] 경고 로그로만 남기고, enforce는 -32602로 거부한다.
# 호출 시점에 읽으므로 재시작 없이 바뀐다.
# MEMENTO_TOOL_ARGS_VALIDATION=warn
# true면 스키마에 없는 필드를 위반으로 세지 않는다 (기본 false).
# MEMENTO_TOOL_ARGS_ALLOW_UNKNOWN=false

# Origin 엄격 검사. true면 허용 목록 밖 Origin을 거부한다 (기본 false).
# MCP_STRICT_ORIGIN=false

# ALLOWED_ORIGINS 미설정 시 교차 출처 응답 방식: reflect | observe(기본) | allowlist
# MEMENTO_CORS_MODE=observe
# deny로 설정하면 모든 응답에 X-Frame-Options: DENY
# MEMENTO_FRAME_OPTIONS=deny
# /authorize 오류 리다이렉트 대상 확인: warn(기본) | enforce
# MEMENTO_OAUTH_REDIRECT_CHECK=warn
# Legacy SSE 쿼리스트링 키: allow(기본) | deny
# MEMENTO_SSE_QUERY_KEY=allow

# 권장 운영 설정 예시 (사용 중인 클라이언트 구성을 확인한 뒤 적용한다).
# 브라우저 Origin이 없는 클라이언트만 쓰는 배포를 가정한 값이다.
# ALLOWED_ORIGINS에는 서비스 자신의 origin만 둔다.
# ALLOWED_ORIGINS=https://memento.example.com
# MEMENTO_CORS_MODE=allowlist
# MEMENTO_FRAME_OPTIONS=deny
# MEMENTO_OAUTH_REDIRECT_CHECK=enforce
# MEMENTO_SSE_QUERY_KEY=deny
# MEMENTO_TOOL_ARGS_VALIDATION=enforce

# session_rotate IP당 분당 호출 상한 (기본 5)
# MEMENTO_ROTATE_RATE_LIMIT_PER_MIN=5

# 신규 API 키 기본값
# DEFAULT_DAILY_LIMIT=10000        # 일일 호출 상한
# DEFAULT_FRAGMENT_LIMIT=          # 파편 상한 (미설정 시 무제한)
# DEFAULT_PERMISSIONS=read,write   # 기본 권한
# QUOTA_NEAR_LIMIT_MARGIN=10       # 잔여 파편 수가 이 값 이하이면 정밀(행 잠금) 검사로 전환

# SSE 연결
# SSE_HEARTBEAT_INTERVAL_MS=25000  # heartbeat 주기
# SSE_MAX_HEARTBEAT_FAILURES=10    # 연속 실패 허용 횟수
# SSE_RETRY_MS=5000               # 클라이언트 재연결 대기 ms (SSE retry: 필드)
# MCP_IDLE_REFLECT_HOURS=24        # 유휴 세션 자동 reflect 기준 시간

# 실행 환경
# NODE_ENV=production              # production이 아니면 기본 로그 레벨이 debug
# MEMENTO_METRICS_DEFAULT=off      # off면 기본 프로세스 메트릭 수집 생략 (단위 시험용)
# MEMENTO_ADMIN_METRICS_SAMPLING=off  # off면 관리 콘솔 메트릭 샘플링 생략
# MEMENTO_ADMIN_AUTH_BACKOFF=off     # on이면 관리 인증 연속 5회 실패 뒤 실패마다 1, 2, 4초...(최대 60초) 지연
#   지연 중에는 올바른 마스터 키도 지연 시간 동안 POST /auth와 관리 API 경로에서 429를 받고(관리 UI 셸과 이미지 경로는 계속 401), 이미 발급된 쿠키 세션은 영향받지 않는다
#   관리 경로에 마스터 키가 아닌 Bearer(일반 API 키 등)를 보낸 실패도 실패로 센다
#   마지막 실패로부터 60초간 실패가 없으면 누적이 새로 시작된다

# 사용자 요청 경로의 질의 시간 상한(ms). 0은 무제한.
# system·admin 에이전트로 도는 유지보수 작업에는 적용하지 않는다.
# DB_STATEMENT_TIMEOUT_MS=30000

# Rate Limiting
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=120

# API 키별 Rate Limiting
# RATE_LIMIT_PER_IP=30      # IP당 분당 요청 한도 (미인증)
# RATE_LIMIT_PER_KEY=100    # API 키당 분당 요청 한도

# ─────────────────────────────────────────
# PostgreSQL
# DATABASE_URL이 설정되지 않으면 scripts/migrate.js가 아래 개별 변수를 조합해
# postgresql://{USER}:{PASSWORD}@{HOST}:{PORT}/{DB} 형태로 DATABASE_URL을 자동 구성한다.
# DATABASE_URL을 직접 지정하면 아래 개별 변수는 무시된다.
# DATABASE_URL=postgresql://your_user:your_password@localhost:5432/your_db
# ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_db
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
# pgvector가 public이 아닌 별도 스키마에 설치된 경우 지정 (선택).
# 미설정 시 서버 시작 및 마이그레이션에서 pg_extension으로 자동 감지.
# 대부분의 환경에서는 비워두면 된다.
# PGVECTOR_SCHEMA=
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT=30000
# GET /health/ready가 주 DB 응답을 기다리는 상한(ms). 와치독 curl 상한 5초보다 짧게 둔다 (기본 2000). 100 이상 4500 이하의 정수만 받고 그 밖의 값은 2000을 쓴다.
# MEMENTO_HEALTH_READY_DB_TIMEOUT_MS=2000
# SIGTERM/SIGINT 종료 절차 전체 상한(ms). 넘기면 강제 종료한다. 0이면 상한 없음 (기본 60000). 0 이상의 정수만 받고
# 음수나 정수가 아닌 값은 60000을 쓴다.
# MEMENTO_SHUTDOWN_DEADLINE_MS=60000
# 숫자, 열거, 불리언 환경 변수의 값 문제(숫자 아님, 정수 아님, 허용 범위 밖, 허용 목록 밖)는 기동 시 한 줄로 기록한다.
# true면 문제가 있을 때 종료 코드 78로 멈춘다 (기본 false).
# MEMENTO_CONFIG_STRICT=false
# 백그라운드 작업(GC, 통합, 임베딩 워커)이 동시에 쓸 수 있는 연결 수. 기본은 DB_MAX_CONNECTIONS의 40%.
# DB_BACKGROUND_MAX_CONNECTIONS=8
# 백그라운드 슬롯 대기 상한(ms). 초과한 작업은 다음 회차에 재시도한다 (기본 120000).
# DB_BACKGROUND_WAIT_MAX_MS=120000
# POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD 대신
# DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD 이름도 인식한다 (POSTGRES_* 우선).
# outbox(on|off, 기본 on). 변경 트랜잭션 안에서 이벤트를 outbox_events 표에 기록하고 작업자가 topic별 처리기로
# 전달한다. off이면 기록하지 않고 작업자도 기동하지 않는다. off인 동안 생산된 이벤트는 영구히 사라지고, 이미 대기 중인 행은
# 다시 on으로 켠 뒤 전달된다.
# MEMENTO_OUTBOX=on
# 이 프로세스에서 outbox 작업자를 돌린다(on|off, 기본 on). off여도 기록은 계속되고 대기 행은 작업자를 돌리는
# 다른 프로세스나 다시 켠 뒤의 작업자가 처리한다.
# MEMENTO_OUTBOX_WORKER=on
# 이벤트 하나의 점유 횟수 상한. 상한에 이른 이벤트의 실패는 dead-letter로 남는다 (기본 12, 1 이상 100 이하).
# MEMENTO_OUTBOX_MAX_ATTEMPTS=12
# 완료한 outbox 행의 보존 일수. 정리 작업이 묶음 단위로 지운다 (기본 7, 1 이상 3650 이하).
# MEMENTO_OUTBOX_RETENTION_DAYS=7
# 작업자 프로세스에 처리기가 등록되지 않은 topic의 미점유 대기 행을 dead-letter(no_handler)로 옮기기까지의 일수. 전달 예정
# 시각부터 센다. 판정은 작업자 프로세스별이므로 작업자를 돌리는 모든 인스턴스가 모든 소비자의 처리기를 등록한다
# (기본 7, 1 이상 3650 이하).
# MEMENTO_OUTBOX_UNHANDLED_DAYS=7

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
# Redis session 저장 실패 시 요청도 실패시킴 (기본 false: in-memory fallback)
# MEMENTO_REDIS_SESSION_FAIL_CLOSED=false
# 전환 릴리즈 기본 true: legacy agentId 사용 시 경고와 mcp_legacy_unbound_agent_scope_total 기록
# 클라이언트 이관 후 false로 설정하면 strict 모드. includePeerAgents는 항상 master 전용.
# MEMENTO_ALLOW_LEGACY_UNBOUND_AGENT_SCOPE=true
# 내부 작업 전용 agentId(system, admin) 처리 방식. warn(기본)은 요청을 통과시키고 경고만 남기며,
# enforce는 API key 요청의 예약 agentId를 거부한다. master key는 두 방식 모두에서 사용할 수 있다.
# MEMENTO_RESERVED_AGENT_IDS=warn
CACHE_ENABLED=true
CACHE_DB_TTL=300
# CACHE_SESSION_TTL=3600  # 기본값: SESSION_TTL_MINUTES와 동일

# Redis Sentinel (선택 — 고가용성 구성 시)
# REDIS_SENTINEL_ENABLED=true
# REDIS_MASTER_NAME=mymaster
# REDIS_SENTINELS=sentinel1:26379,sentinel2:26379,sentinel3:26379

# ── Embedding Provider ──────────────────────────────────────────
# 지원값: openai (기본) | gemini | ollama | localai | cloudflare | custom | transformers (v2.9.0 로컬)
EMBEDDING_PROVIDER=openai

# OpenAI (EMBEDDING_PROVIDER=openai, 기본값)
OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small   # 기본값, 생략 가능
# EMBEDDING_DIMENSIONS=1536                 # 기본값, 생략 가능

# Google Gemini (EMBEDDING_PROVIDER=gemini)
# text-embedding-004는 2026-01-14 종료. 현재 권장: gemini-embedding-001
# EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# EMBEDDING_MODEL=gemini-embedding-001      # 기본값, 생략 가능
# EMBEDDING_DIMENSIONS=3072                 # 기본값, 생략 가능
# ※ 3072차원 최초 사용 시 migration-007 실행 필요:
#   EMBEDDING_DIMENSIONS=3072 DATABASE_URL=$DATABASE_URL node scripts/post-migrate-flexible-embedding-dims.js

# Ollama 로컬 서버 (EMBEDDING_PROVIDER=ollama)
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text          # 기본값, 생략 가능
# EMBEDDING_DIMENSIONS=768                  # 기본값, 생략 가능

# LocalAI (EMBEDDING_PROVIDER=localai)
# EMBEDDING_PROVIDER=localai
# EMBEDDING_MODEL=text-embedding-ada-002    # 기본값, 생략 가능

# Cloudflare Workers AI (EMBEDDING_PROVIDER=cloudflare)
# EMBEDDING_PROVIDER=cloudflare
# CF_ACCOUNT_ID=your-cloudflare-account-id
# CF_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN 이름도 같은 값으로 인식한다.
# EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5   # 기본값, 생략 가능
# EMBEDDING_DIMENSIONS=384                       # 기본값, 생략 가능

# 커스텀 OpenAI 호환 서버 (EMBEDDING_PROVIDER=custom)
# EMBEDDING_PROVIDER=custom
# EMBEDDING_BASE_URL=http://my-server:8080/v1
# EMBEDDING_API_KEY=my-api-key
# EMBEDDING_MODEL=my-model
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_SUPPORTS_DIMS_PARAM=false       # dimensions 파라미터 지원 여부 (기본: false)

# 로컬 transformers.js (EMBEDDING_PROVIDER=transformers, v2.9.0+)
# API 키 없이 Xenova/multilingual-e5-small(384d) 또는 Xenova/bge-m3(1024d) 로컬 실행
# 주의: API 키(OPENAI_API_KEY 등)와 동시 설정 시 config 로딩에서 throw (상호 배타)
# EMBEDDING_PROVIDER=transformers
# EMBEDDING_MODEL=Xenova/multilingual-e5-small
# EMBEDDING_DIMENSIONS=384
# 또는: EMBEDDING_MODEL=Xenova/bge-m3 / EMBEDDING_DIMENSIONS=1024

# 임베딩 호출 공통 조정
# EMBEDDING_TIMEOUT_MS=8000        # 호출당 타임아웃
# EMBEDDING_MAX_RETRIES=0          # 실패 시 재시도 횟수
# EMBEDDING_CONCURRENCY=6          # 동시 호출 상한
# EMBEDDING_SEM_WAIT_MS=3000       # 동시 호출 슬롯 대기 상한
# 상세: docs/embedding-local.md 참조

# 한국어 회상 품질 참고: 100문항 골드셋을 운영 파편 5000건과 함께 잰 실측에서
# text-embedding-3-small은 Recall@5 78.0%, Xenova/bge-m3는 97.0%였다.
# bge-m3는 CPU에서 약 250ms/건이므로 대량 재임베딩 시 시간을 확보해야 한다.

# ─────────────────────────────────────────
# 검색 튜닝 (v5.8.0+)
# ─────────────────────────────────────────
# 질의 의도별 검색 프로파일. 질의를 EXACT_SYMBOL / CONCEPT_INTENT / HYBRID로
# 분류해 RRF 레이어 가중, 시맨틱 임계값, lexical 가중치를 함께 전환한다.
# 기본 활성. 회귀 시 false로 즉시 되돌릴 수 있다.
# MEMENTO_QUERY_PROFILE_ENABLED=false

# 합성 역질의 증강. 파편 저장 시 회상용 질문을 LLM으로 만들어 보조 벡터로 색인한다.
# 파편당 LLM 1회와 임베딩 2~3회가 추가되므로 기본 비활성(옵트인)이다.
# MEMENTO_SYNTHETIC_QUERY_ENABLED=true
# MEMENTO_SYNTHETIC_QUERY_SEARCH=false          # 이미 쌓인 보조 벡터 조회까지 끄려면
# MEMENTO_SYNTHETIC_QUERY_MIN_IMPORTANCE=0.8    # 생성 대상 최소 중요도
# MEMENTO_SYNTHETIC_QUERY_TYPES=error,procedure,decision
# MEMENTO_SYNTHETIC_QUERY_RPM=20                # 분당 LLM 호출 상한, 0이면 무제한

# ─────────────────────────────────────────
# LLM Provider Chain (v2.8.0+)
# 형태소 분리(MorphemeIndex), 자동 reflect(AutoReflect), 모순 탐지(ConflictResolver),
# 기억 평가(MemoryEvaluator), GC 요약(ConsolidatorGC)에 사용.
# LLM_PRIMARY → LLM_FALLBACKS 순차 폴백.
# ─────────────────────────────────────────

# 주 provider (기본값: gemini-cli)
LLM_PRIMARY=gemini-cli

# Fallback chain (JSON 배열). provider당 {provider, model?, apiKey?, baseUrl?} 구성.
# CLI provider(gemini-cli/codex-cli/copilot-cli)는 model/apiKey 불필요.
# API provider는 apiKey+model 필수. Ollama Cloud 예시 포함.
# LLM_FALLBACKS='[{"provider":"codex-cli"},{"provider":"copilot-cli"},{"provider":"ollama","baseUrl":"https://ollama.com","apiKey":"ollama_...","model":"glm-5.1:cloud"}]'

# LLM 호출 타임아웃
# LLM_PROVIDER_TIMEOUT_MS=60000    # provider 1회 호출 상한(ms)
# LLM_CHAIN_TIMEOUT_MS=0           # 체인 전체 상한(ms), 0이면 provider별 상한만 적용

# CLI provider(gemini-cli, codex-cli, copilot-cli, qwen-cli, agy-cli, opencode-cli)의 자식 프로세스는
# PATH, HOME 등 기본 변수와 CLI별 인증 변수만 받는다. 추가로 전달할 변수 이름을 쉼표로 지정한다.
# MEMENTO_LLM_CLI_ENV_PASSTHROUGH=OPENAI_API_KEY,MY_CLI_TOKEN

# gemini-cli, copilot-cli, opencode-cli의 도구 실행 승인 방식. 호출 시점에 읽는다.
#   none(기본): 세 CLI 모두 서버 작업 디렉터리가 아닌 빈 임시 디렉터리에서 실행한다.
#               gemini는 -y를 붙이지 않는다. copilot은 비대화형 실행용 --allow-all-tools를
#               유지하고 쓰기, 셸, URL 도구와 내장 MCP를 거부한다. opencode는 모든 권한을 거부한다.
#   all       : 서버 작업 디렉터리에서 실행한다. gemini는 -y, copilot은 --allow-all-tools를 쓰고
#               opencode는 승인 관련 설정을 추가하지 않는다.
# gemini-cli, copilot-cli, opencode-cli를 쓰는 배포는 기본에서 제한된 호출을 받으며,
# MEMENTO_LLM_CLI_TOOL_APPROVAL=all로 설정하면 승인 제한이 없는 호출을 쓴다.
# MEMENTO_LLM_CLI_TOOL_APPROVAL=none

# 지원 provider: openai, anthropic, gemini, groq, openrouter, xai, ollama, vllm,
#                deepseek, mistral, cohere, zai, gemini-cli, agy-cli, codex-cli, copilot-cli,
#                qwen-cli, opencode-cli

# splitLongFragments 전용 provider 체인 (선택 — 미설정 시 전역 체인 재사용)
# 설정 시 splitLongFragments stage가 이 체인만 사용하여 전역 LLM 호출량과 분리된다.
# 미설정(null 반환) 시 LLM_PRIMARY/LLM_FALLBACKS 전역 체인을 그대로 사용한다.
# MEMENTO_SPLIT_LLM_PRIMARY=gemini-cli
# MEMENTO_SPLIT_LLM_FALLBACKS='[{"provider":"codex-cli"},{"provider":"copilot-cli"}]'

# LLM Provider 동시성 제어 (v2.8.1+)
# - LLM_CONCURRENCY_ENABLED=true|false (기본 true, false로 끄면 세마포어 우회)
# - LLM_CONCURRENCY_WAIT_MS=30000 (슬롯 대기 타임아웃, 초과 시 다음 fallback으로 전환)
# - LLM_CONCURRENCY (JSON): chainKey 또는 provider 이름 기준 슬롯 한도. 미지정 키는 10.
#   chainKey 형식: "provider|baseUrl|model" (예: "openai|https://llm.example.com/v1|google/gemma-4-31B-it")
#   내장 기본값: ollama=16, xiaomi/mimo-v2-pro=8, CLI 류=1
# LLM_CONCURRENCY='{"ollama":16,"gemini-cli":1}'

# Circuit Breaker 튜닝 (선택)
# LLM_CB_FAILURE_THRESHOLD=5       # LLM_CB_FAILURE_WINDOW_MS 안의 실패가 이 횟수에 닿으면 open (기본 5)
# LLM_CB_OPEN_DURATION_MS=60000    # open 상태 지속 시간 ms (기본 60000)
# LLM_CB_FAILURE_WINDOW_MS=60000   # 실패 집계 윈도우 ms (기본 60000)

# Token 사용량 상한 (선택)
# LLM_TOKEN_BUDGET_INPUT=           # 입력 토큰 상한 (미설정 시 무제한)
# LLM_TOKEN_BUDGET_OUTPUT=          # 출력 토큰 상한 (미설정 시 무제한)
# LLM_TOKEN_BUDGET_WINDOW_SEC=86400 # 집계 윈도우 초 (기본 86400 = 1일)

# ─────────────────────────────────────────
# MorphemeIndex (v2.9.0 timeout 상향: 15s → 60s)
# config/memory.js morphemeIndex.geminiTimeoutMs 기본 60000
# LLM 체인 실패 시 _fallbackTokenize로 자동 우회 (fatal 아님)
# ─────────────────────────────────────────

# ─────────────────────────────────────────
# AutoReflect LLM chain timeout (v3.2.0)
# ─────────────────────────────────────────
# AutoReflect의 LLM chain 호출 timeout (밀리초). 게이트웨이 60s 컷오프 회피 마진 확보.
# 코드 상수 GEMINI_TIMEOUT_MS = 30_000 (lib/memory/processors/AutoReflect.js:29).
# 환경변수로 지정하는 값이 아니며, 변경하려면 해당 파일의 상수를 직접 수정한다.

# ─────────────────────────────────────────
# batchPool 전용 DB URL (v3.2.0, 선택)
# ─────────────────────────────────────────
# (선택) batchPool 전용 DATABASE_URL. 미설정 시 DATABASE_URL을 공유.
# batchPool은 multi-row INSERT 같은 무거운 트랜잭션을 별도 풀에서 처리하여 recall starvation 방지.
# batchPool 동작(max=primaryMax×0.3, application_name='memento-mcp:batch')은 코드 내부 결정.
# BATCH_DATABASE_URL=postgres://...

# ─────────────────────────────────────────
# NLI 분류기 (선택 — 외부 서비스 사용 시)
# 미설정 시 in-process ONNX 모델 자동 사용
# ─────────────────────────────────────────
# NLI_SERVICE_URL=http://localhost:8080
# NLI_TIMEOUT_MS=5000

# ─────────────────────────────────────────
# 기억 시스템 유지보수
# ─────────────────────────────────────────
# CONSOLIDATE_INTERVAL_MS=21600000   # 자동 유지보수 간격 ms (기본 6시간)
# Automatic anchor promotion keeps the historical behavior by default.
# Set false to require explicit amend(isAnchor=true) for future promotions.
# MEMENTO_AUTO_PROMOTE_ANCHORS=true

# context anchor 기본 상한은 20개다. effective workspace가 있으면 기본 10개를
# 해당 workspace의 상위 anchor에 먼저 예약하고 나머지는 workspace/global 통합
# 중요도순으로 채운다. total만 바꾸면 reserve는 total/2 내림(최대 10)으로 유도된다.
# MEMENTO_CONTEXT_ANCHOR_LIMIT=20
# MEMENTO_CONTEXT_WORKSPACE_ANCHOR_RESERVE=10

# 통합(consolidate) 단계 조정
# schemaFit 게이트 판정 방식: any(조건 하나라도 충족) | all(전부 충족)
# MEMENTO_CONSOLIDATE_GATE_MODE=any
# LLM 재작성을 수반하는 단계의 활성화 여부
# MEMENTO_CONSOLIDATE_SPLIT_LONG=true         # 긴 파편 분할
# MEMENTO_CONSOLIDATE_DETECT_CONTRADICT=true  # 모순 탐지
# MEMENTO_CONSOLIDATE_COMPRESS_OLD=false      # 오래된 파편 압축
# 긴 파편 분할 게이트
# MEMENTO_SPLIT_SUBJECT_GATE=true             # 부모 본문의 주제 앵커가 없는 조각은 폐기
# MEMENTO_SPLIT_MODALITY_GATE=true            # 부모에 없던 양상 표현이 생긴 조각은 폐기

# batch_remember 한 번에 허용하는 content 총 문자 수 (기본 200000)
# BATCH_REMEMBER_MAX_TOTAL_CHARS=200000
# 에피소드 연속성 조회 캐시 TTL(ms, 기본 5000)
# EPISODE_CONTINUITY_CACHE_TTL_MS=5000

# remember 직후 자동 링크 생성
# MEMENTO_PROACTIVE_RECALL_MODE=auto              # off | auto | legacy
# MEMENTO_PROACTIVE_KW_OVERLAP_MIN=0.5            # 자동 링크 후보의 키워드 겹침 하한
# MEMENTO_PROACTIVE_CASE_POLICY=strict-or-adjacent  # both-required | strict-or-adjacent | loose
# 결과 피드백 샘플링과 사례 보상 전파
# MEMENTO_FEEDBACK_SAMPLING=true
# MEMENTO_CASE_BACKPROP_ENABLED=false

# 검색 보조
# MEMENTO_RECALL_MIN_SIM_FLOOR=                   # 설정 시 적응형 minSimilarity의 하한을 강제
# MEMENTO_KEYWORD_SEMANTIC_FALLBACK=true          # keywords 전용 질의의 L3 시맨틱 보조
# MEMENTO_KEYWORD_FALLBACK_TIMEOUT_MS=1500        # 위 보조 경로의 상한(ms)
# MEMENTO_WORKSPACE_DECAY=true                    # workspace 불일치 파편 랭킹 감쇠
# MEMENTO_WORKSPACE_DECAY_PENALTY=0.7             # 감쇠 배율

# 형태소 분석: local(기본, 로컬 분석기) | llm(LLM provider 체인)
# MEMENTO_MORPHEME_TOKENIZER=local
# MEMENTO_ENABLE_KUROMOJI=true                    # false면 일본어 분석기(kuromoji)를 로드하지 않음(메모리 약 269MB 절감)

# 세션 세그먼트
# MEMENTO_SESSION_SEGMENT=true
# MEMENTO_SEGMENT_IDLE_MS=2700000                 # 유휴 회전 기준(ms)
# MEMENTO_SEGMENT_MAX_AGE_MS=43200000             # 최대 수명(ms)
# MEMENTO_SEGMENT_MIN_ACTIVITY=3                  # AutoReflect 발동에 필요한 최소 활동 수

# 세션 사용 시 API 키 상태 재확인 주기(ms). 0이면 재확인하지 않는다.
# 0 이상의 정수만 받고 그 밖의 값은 30000을 쓴다.
# MEMENTO_SESSION_KEY_RECHECK_MS=30000

# 보조 질의(synthetic query) 워커 조정
# MEMENTO_SYNTHETIC_QUERY_INTERVAL_MS=5000
# MEMENTO_SYNTHETIC_QUERY_BATCH=5
# MEMENTO_SYNTHETIC_QUERY_TIMEOUT_MS=20000
# MEMENTO_SYNTHETIC_QUERY_ADOPT=5                 # 한 검색에서 합류시킬 최대 파편 수
# MEMENTO_SYNTHETIC_QUERY_BACKFILL=20             # 백필 1회 처리 파편 수

# 저장소 백엔드 이름. 현재 pgvector 하나이며 이 값은 동작에 영향을 주지 않는다
# MEMENTO_STORAGE=pgvector

# ─────────────────────────────────────────
# 기억 중복 제거 및 압축
# ─────────────────────────────────────────
# DEDUP_BATCH_SIZE=100
# DEDUP_MIN_FRAGMENTS=5
# COMPRESS_AGE_DAYS=30
# COMPRESS_MIN_GROUP=3

# ─────────────────────────────────────────
# 벡터 검색 플래너 힌트
# ─────────────────────────────────────────
# 벡터 검색 시 HNSW 인덱스 강제 (소규모 테이블 planner cost 역전 회피).
# 기본 on. 문제 진단 시에만 off로 두어 planner 기본 동작으로 되돌린다.
MEMENTO_VECTOR_FORCE_INDEX=on

# 시맨틱 검색 임계값 적용 위치. inner: KNN 질의 안, outer: 이웃 max(limit, 80)개를 먼저 고른 뒤 바깥.
# MEMENTO_SEMANTIC_THRESHOLD_MODE=inner
# 통합 단계의 감쇠, utility 갱신을 id 오름차순 묶음으로 나눌 때의 묶음 크기.
# 0이면 단일 UPDATE 문장으로 갱신한다. 기본 200.
# 0 이상의 정수만 받고(음수와 정수가 아닌 값은 200을 쓴다) 10000을 넘으면 10000으로 줄인다.
# forget의 linked_to 정리는 이 값과 무관하게 항상 id 오름차순으로 행을 잠근다.
# MEMENTO_SCORE_UPDATE_BATCH=200
# 묶음 갱신에서 감쇠량이 이 값보다 작은 행은 건너뛴다(마지막 감쇠 후 24시간이 지난 행은 항상 갱신). 0이면 모두 갱신.
# 숫자가 아니거나 음수인 값은 0으로 처리하고 경고를 남기며, 1을 넘는 값은 1로 제한한다.
# 하한(0.05)에 닿은 행은 24시간 상한 때문에 대략 네 번에 한 번 다시 쓰인다.
# MEMENTO_DECAY_MIN_DELTA=0
# 묶음 갱신에서 저장값과의 차이가 이 값 이하인 utility_score는 다시 쓰지 않는다. 0이면 저장형 기준으로 바뀐 행만 갱신.
# 숫자가 아니거나 음수인 값은 0으로 처리하고 경고를 남기며, 1을 넘는 값은 1로 제한한다.
# MEMENTO_UTILITY_MIN_DELTA=0

# ─────────────────────────────────────────
# Cross-Encoder Reranker (L4)
# ─────────────────────────────────────────
# In-process 리랭커는 기본 비활성이다. 기본 모델이 영어 MS MARCO 전용이라
# 한국어 질의에서 상류 벡터 순위를 오히려 망가뜨린다. 실측으로 이 리랭커를
# 끄면 Recall@1 74%→85%, MRR 0.827→0.890, p50 561ms→126ms로 개선된다.
# 영어 코퍼스에서는 이득일 수 있으므로 켜는 경로를 남긴다.
# MEMENTO_RERANKER_ENABLED=true

# 외부 reranker 서비스 URL (POST /rerank). 지정하면 위 스위치와 무관하게 동작한다.
# RERANKER_URL=https://reranker.example.com
# RERANKER_TIMEOUT_MS=5000
# 외부 리랭커 연속 실패 시 동작: skip(기본, 쿨다운 동안 호출 생략하고 원본 점수 유지) | inprocess(in-process 모델로 전환)
# RERANKER_EXTERNAL_FALLBACK=skip
# skip 모드의 쿨다운 길이(ms, 기본 60000)
# RERANKER_EXTERNAL_COOLDOWN_MS=60000

# In-process 모델 (transformers.js). MEMENTO_RERANKER_ENABLED=true 일 때만 쓰인다.
# minilm  : Xenova/ms-marco-MiniLM-L-6-v2 (기본, ~80MB, 영어 전용)
# bge-m3  : onnx-community/bge-reranker-v2-m3-ONNX (~280MB, 다국어)
#           품질은 낫지만 CPU에서 30건 재정렬에 수 초가 걸린다. GPU 없이는 권장하지 않는다.
# RERANKER_MODEL=minilm

# ─────────────────────────────────────────
# 압축
# ─────────────────────────────────────────
# COMPRESSION_LEVEL=6              # gzip 압축 레벨 (0-9, 기본 6)
# MIN_COMPRESS_SIZE=1024           # 압축 최소 크기 (bytes, 기본 1024)

# ─────────────────────────────────────────
# 워커
# ─────────────────────────────────────────
# WORKER_ID=                       # 클러스터 워커 ID (빈 값 = 단일 프로세스)

# ─────────────────────────────────────────
# 메모리 평가
# ─────────────────────────────────────────
# EVALUATOR_MAX_QUEUE=100          # Gemini 품질 평가 최대 큐 크기

# ─────────────────────────────────────────
# 파편 할당량 (v2.6.0+)
# ─────────────────────────────────────────
# FRAGMENT_DEFAULT_LIMIT=5000      # 동작에 영향 없음. 키 생성 기본 상한은 DEFAULT_FRAGMENT_LIMIT

# ─────────────────────────────────────────
# OpenAPI
# ─────────────────────────────────────────
# ENABLE_OPENAPI=true              # GET /openapi.json 활성화 (master=전체, API key=권한 필터)

# ─────────────────────────────────────────
# OAuth 2.0 + DCR (v2.8.0+)
# ─────────────────────────────────────────
# 신뢰 redirect_uri 도메인 (claude.ai/chatgpt.com/copilot.microsoft.com 등 사전 내장)
# OAUTH_TRUSTED_ORIGINS=https://yourorg.com

# 미등록 client_id의 /authorize 자동 등록 허용 (기본 false, 신뢰 origin만 자동 등록)
# MCP_ALLOW_AUTO_DCR_REGISTER=false

# API 키에 바인딩되지 않은 OAuth 토큰 거부 (v2.8.5+, 기본 true)
# MCP_REJECT_NONAPIKEY_OAUTH=true

# api_keys 조회 실패로 인증을 판정하지 못한 MCP initialize·세션 복구 응답 상태. 401(기본) 또는 503(Retry-After: 10)
# MEMENTO_AUTH_STORE_UNAVAILABLE_STATUS=401

# MCP 세션 ID 수신 처리. warn(기본)은 쿼리스트링 ID와 UUID가 아닌 ID의 복구를 기록만 하고 통과, enforce는 각각 400, 404
# MEMENTO_SESSION_ID_POLICY=warn

# 갱신 토큰 수명은 SESSION_TTL_MINUTES * 60 * 2초. 접근 토큰 수명은 기본적으로 SESSION_TTL_MINUTES * 60초
# 접근 토큰 수명 지정(초, 양의 정수). 미설정이면 세션 수명과 같다. 갱신 토큰 수명은 영향받지 않는다
# OAUTH_ACCESS_TOKEN_TTL_SECONDS=

# /register 시간당 등록 상한(프로세스 단위, 기본 100, 0이면 상한 없음). 초과 시 429와 Retry-After(현재 창의 남은 초)
# 유효한 API 키를 Bearer로 제시한 등록은 같은 값을 쓰는 별도 집계라 무인증 등록이 상한에 닿아도 영향받지 않는다
# MEMENTO_DCR_MAX_PER_HOUR=100

# ─────────────────────────────────────────
# Symbolic Verification Layer (v2.8.0+)
# 모든 플래그는 기본 false. 활성화 시 remember/recall 응답 필드 추가.
# ─────────────────────────────────────────
# 전체 symbolic 서브시스템 마스터 킬 스위치 (false 시 비용 0)
# MEMENTO_SYMBOLIC_ENABLED=false

# Claim 추출 (Phase 0/1, MEMENTO_SYMBOLIC_ENABLED=true 전제)
# MEMENTO_SYMBOLIC_CLAIM_EXTRACTION=false

# 검색 이유 설명 (recall 응답의 explanations 필드, Phase 2)
# MEMENTO_SYMBOLIC_EXPLAIN=false

# 링크 무결성 검사 advisory (Phase 3)
# MEMENTO_SYMBOLIC_LINK_CHECK=false

# 모순 탐지 advisory (Phase 3)
# MEMENTO_SYMBOLIC_POLARITY_CONFLICT=false

# 정책 규칙 soft gating (remember 응답의 validation_warnings 필드, Phase 4)
# MEMENTO_SYMBOLIC_POLICY_RULES=false

# CBR 케이스 검색 symbolic 필터 (Phase 5)
# MEMENTO_SYMBOLIC_CBR_FILTER=false

# Proactive gate — 링크 생성 차단 (Phase 5)
# MEMENTO_SYMBOLIC_PROACTIVE_GATE=false

# Shadow mode — 규칙 평가를 기록만 하고 미적용 (Phase 1)
# MEMENTO_SYMBOLIC_SHADOW=false

# Symbolic 엔진 튜닝 (config/symbolic.js:47-49)
# MEMENTO_SYMBOLIC_RULE_VERSION=v1        # 적용할 규칙 파일 버전 (기본 v1)
# MEMENTO_SYMBOLIC_MAX_CANDIDATES=32      # 후보 파편 상한 설정값; 현재 이 값을 읽는 처리는 없다 (기본 32)
# MEMENTO_SYMBOLIC_TIMEOUT_MS=50          # symbolic 평가 timeout 설정값 ms; 현재 이 값을 읽는 처리는 없다 (기본 50)

# ─────────────────────────────────────────
# Experiential Memory (v2.5.0+, 전부 기본 false)
# ─────────────────────────────────────────
# 재통합: recall 시 링크 weight/confidence 갱신
# ENABLE_RECONSOLIDATION=false

# 확산 활성화: contextText 기반 이웃 파편 사전 부스트
# ENABLE_SPREADING_ACTIVATION=false

# 패턴 추상화 예약 변수. 현재 읽는 처리가 없어 설정해도 동작에 영향이 없다.
# ENABLE_PATTERN_ABSTRACTION=false

# ─────────────────────────────────────────
# Server / Reliability
# ─────────────────────────────────────────
# 단일 remember() 요청에서 quota check + INSERT를 단일 트랜잭션으로 원자화한다.
# true: BEGIN → api_keys FOR UPDATE(quota 재검증) → INSERT → COMMIT (TOCTOU 완전 차단)
# false(기본): 선제 quota check만 수행 (기존 동작 보존, 동시 요청이 드문 환경에 적합)
# v2.10.1 R12 핫픽스로 TDZ 버그 수정 완료, atomic 경로 정상 동작.
# MEMENTO_REMEMBER_ATOMIC=false

# remember가 같은 키 범위의 기존 파편과 같은 본문을 받았을 때, true면 기존 파편을 고치지 않고
# existing, duplicate 필드로 상태만 알린다. 기본 false(현행 흐름). 분류 계수기는 항상 동작한다.
# MEMENTO_REMEMBER_DUPLICATE_GUARD=false

# 관리 화면의 API 키 삭제 전에 그 키의 파편과 링크 재공고화 이력을 확인한다. 있으면 409로 거부한다.
# false면 확인 없이 삭제한다. 기본 true.
# MEMENTO_API_KEY_DELETE_GUARD=true

# ─────────────────────────────────────────
# CLI 원격 접속 (v2.12.0 M1)
# memento-mcp CLI를 원격 MCP 서버에 연결할 때 사용.
# --remote / --key 플래그 미지정 시 아래 값이 fallback으로 사용된다.
# ─────────────────────────────────────────
# MEMENTO_CLI_REMOTE=https://memento.anchormind.net/mcp
# MEMENTO_CLI_KEY=mmcp_xxx

# ─────────────────────────────────────────
# 업데이트 확인과 적용
# ─────────────────────────────────────────
# UPDATE_CHECK_DISABLED=false        # true면 CLI 기동 시 업데이트 확인 생략
# UPDATE_CHECK_INTERVAL_HOURS=24     # 업데이트 확인 캐시 유지 시간
# UPDATE_REQUIRE_SIGNED_TAG=false    # true면 git 설치본 업데이트 전에 git verify-tag로 대상 태그 서명을 확인
# GITHUB_TOKEN=                      # GitHub API 호출 한도 완화용 (선택)
# MEMENTO_RUNTIME=                   # docker로 지정하면 설치 방식을 docker로 판정

# 마이그레이션 규약 점검(npm run lint:migrations)이 이 번호 이상만 검사한다. 미지정 시 전체 검사
# MIGRATION_LINT_FROM=0

# ─────────────────────────────────────────
# 와치독 (memento-watchdog.sh)
# ─────────────────────────────────────────
# 서버 .env가 아니라 와치독을 실행하는 cron 작업의 환경에서 읽는다. 초 단위 값은 0 이상의 정수.
# MEMENTO_WATCHDOG_BASE_URL=http://127.0.0.1:57332       # 상태 확인 대상 주소
# MEMENTO_WATCHDOG_SERVICE=memento-mcp.service           # 재시작할 systemd 서비스 이름
# MEMENTO_WATCHDOG_STATE_FILE=/tmp/memento-watchdog.state # 상태 파일 경로
# MEMENTO_WATCHDOG_LOCK_FILE=                            # 잠금 파일. 기본은 상태 파일 경로에 .lock을 붙인 값
# MEMENTO_WATCHDOG_STARTUP_GRACE_SEC=120                 # 서비스 기동 후 재시작을 보류하는 시간(초)
# MEMENTO_WATCHDOG_BACKOFF_BASE_SEC=60                   # 연속 재시작 사이의 첫 대기 시간(초)
# MEMENTO_WATCHDOG_BACKOFF_MAX_SEC=1800                  # 연속 재시작 대기 시간의 상한(초)
# MEMENTO_WATCHDOG_RESTART_CMD=                          # 지정하면 sudo systemctl restart 대신 실행할 명령
# MEMENTO_WATCHDOG_NOW=                                  # 시험용 시각 주입(epoch 초)
# MEMENTO_WATCHDOG_SERVICE_AGE_SEC=                      # 시험용 기동 후 경과 초 주입
# MEMENTO_WATCHDOG_ACTIVE_ENTER_TIMESTAMP=               # 시험용 서비스 기동 시각 주입

# ─────────────────────────────────────────
# 백업 (scripts/ops/backup.sh)
# ─────────────────────────────────────────
# 서버 .env가 아니라 백업을 실행하는 셸이나 cron 작업의 환경에서만 읽는다. 서버는 읽지 않는다.
# MEMENTO_BACKUP_DIR=                # 저장 위치. 저장소 밖 경로. 기본은 $XDG_STATE_HOME/memento-mcp/backups 또는 $HOME/.local/state/memento-mcp/backups
# MEMENTO_BACKUP_KEEP_DAYS=14        # 보관 일수. 1 이상 9999 이하의 정수
